#!/usr/bin/env bash

set -euo pipefail

remote="origin"
base_branch="${remote}/main"
session_key="review.session"

usage() {
    cat <<'EOF'
Usage:
  git review <branch>
  git review --restore

Starts a review by fetching origin, saving the current working tree in a stash,
and exposing <branch>'s changes since its merge base with origin/main as
unstaged changes. Running it again during a review switches to the new <branch>
directly, discarding the current review changes.

Run `git review --restore` after reviewing to discard the review changes and
restore the original branch, staged changes, unstaged changes, and untracked
files. Ignored files are preserved throughout the review.
EOF
}

die() {
    echo "git review: $*" >&2
    exit 1
}

ensure_repository() {
    git rev-parse --show-toplevel >/dev/null || exit 1
}

# Prints the reflog selector (stash@{n}) of the stash whose object ID is $1, or nothing when it is
# not in the stash list. `git stash drop` accepts a selector rather than an object ID.
stash_selector() {
    local hash selector
    while read -r hash selector; do
        if [[ "$hash" == "$1" ]]; then
            printf '%s' "$selector"
            return
        fi
    done < <(git stash list --format='%H %gd')
}

restore() {
    local session original_branch original_head stash_ref stash_selector

    session="$(git config --local --get "$session_key" 2>/dev/null)" ||
        die "no active review session"
    IFS=: read -r original_branch original_head stash_ref <<<"$session"

    # Verify everything needed for recovery before discarding the review state.
    if [[ -n "$original_branch" ]]; then
        git show-ref --verify --quiet "refs/heads/${original_branch}" ||
            die "original branch no longer exists: ${original_branch}"
    else
        git rev-parse --verify --quiet "${original_head}^{commit}" >/dev/null ||
            die "original commit is no longer available: ${original_head}"
    fi

    if [[ -n "$stash_ref" ]]; then
        git rev-parse --verify --quiet "${stash_ref}^{commit}" >/dev/null ||
            die "saved working tree is no longer available: ${stash_ref}"
    fi

    # Review state is deliberately dirty after reset. Discard its tracked
    # changes, but leave untracked files alone.
    git reset --hard

    if [[ -n "$original_branch" ]]; then
        git switch "$original_branch"
    else
        git switch --detach "$original_head"
    fi

    if [[ -n "$stash_ref" ]]; then
        git stash apply --index "$stash_ref" || die \
            "could not reapply the saved changes; they remain available as ${stash_ref}"

        # Look the stash up by the ID stored at the start of the session so a stash created
        # during review is never removed accidentally.
        stash_selector="$(stash_selector "$stash_ref")"
        if [[ -n "$stash_selector" ]]; then
            git stash drop "$stash_selector" >/dev/null ||
                echo "git review: restored changes, but could not remove ${stash_selector}" >&2
        else
            echo "git review: restored changes; temporary stash ${stash_ref} was already removed" >&2
        fi
    fi

    git config --local --unset-all "$session_key" 2>/dev/null || true
    echo "Original working tree restored."
}

start_review() {
    local remote target_branch review_base
    remote="$1"
    target_branch="$2"
    review_base="$3"

    local session_active=""
    git config --local --get "$session_key" >/dev/null 2>&1 && session_active=1

    git fetch "$remote"

    # Resolve the new target before touching the working tree, so a bad branch name never
    # discards the review in progress.
    local merge_base
    merge_base="$(git merge-base "$review_base" "$target_branch" 2>/dev/null)" ||
        die "could not find a merge base between ${target_branch} and ${review_base}"

    if [[ -n "$session_active" ]]; then
        # Switching reviews: keep the saved session for `--restore`, and only discard the
        # tracked changes of the current review, like `restore` does.
        git reset --hard
    else
        local original_branch original_head stash_ref stash_before
        original_branch="$(git symbolic-ref --quiet --short HEAD || true)"
        original_head="$(git rev-parse HEAD)"
        stash_ref=""

        stash_before="$(git rev-parse --verify --quiet refs/stash || true)"
        # Some callers (e.g. Vim Fugitive Async Call) enable literal pathspecs, which prevents
        # stash from removing files. Add "--no-literal-pathspecs" to override that mode for this
        # operation.
        git --no-literal-pathspecs stash push --include-untracked --message \
            "git-review: automatic backup" >/dev/null
        stash_ref="$(git rev-parse --verify --quiet refs/stash || true)"
        [[ "$stash_ref" != "$stash_before" ]] || stash_ref=""

        git config --local "$session_key" "${original_branch}:${original_head}:${stash_ref}"
    fi

    git switch --detach "$target_branch"
    git reset --mixed --intent-to-add "$merge_base"

    echo "Review ready: ${target_branch} against the merge base with ${review_base}"
    echo "Use 'git diff' or open the repository in your editor."
    echo "When finished, run: git review --restore"
}

# Git's own commands print their options for these flags; shell completion
# (`__gitcomp_builtin`) and Vim Fugitive's `:Git` completion both rely on them.
if [[ "${1:-}" == --git-completion-helper || "${1:-}" == --git-completion-helper-all ]]; then
    echo "--restore"
    exit 0
fi

ensure_repository

case "${1:-}" in
-h)
    [[ $# -eq 1 ]] || die "-h does not accept additional arguments"
    usage
    ;;
--restore)
    [[ $# -eq 1 ]] || die "--restore does not accept additional arguments"
    restore
    ;;
*)
    [[ $# -eq 1 ]] || {
        usage >&2
        exit 1
    }

    branch="${1#"${remote}"/}"
    target_branch="${remote}/${branch}"
    start_review "$remote" "$target_branch" "$base_branch"
    ;;
esac
